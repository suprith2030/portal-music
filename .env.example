# ═══════════════════════════════════════════════════
# PORTAL // AUDIO OS — Environment Configuration
# ═══════════════════════════════════════════════════

# ── Supabase Database ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Cloudinary (Direct Browser Uploads + Two-Way Sync & Deletion) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Cloudinary API Credentials (required for two-way sync & deleting files from Cloudinary storage)
# Find these on your Cloudinary Dashboard under "API Keys"
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Admin Security PIN ──
NEXT_PUBLIC_ADMIN_PIN=2026
ADMIN_PIN=2026
